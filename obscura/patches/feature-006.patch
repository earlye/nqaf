+#[cfg(test)]
+mod op_safety_tests {
+    use super::*;
+
+    // Lets the check below scan this file's own source text.
+    const SRC: &str = include_str!("ops.rs");
+
+    // Synchronous ops that cannot route through op_guard. Keep empty unless an
+    // op's fallback genuinely cannot be constructed; justify every entry.
+    const SYNC_OPS_EXEMPT_FROM_GUARD: &[&str] = &[];
+
+    /// Ops declared with `#[op2]` before this test module, as
+    /// (name, is_async, body). Needles are built with concat! so this
+    /// module's own string literals never match them.
+    fn scan_ops() -> Vec<(String, bool, String)> {
+        let attr = concat!("#[", "op2");
+        let stop = concat!("mod ", "op_safety_tests");
+        let lines: Vec<&str> = SRC.lines().take_while(|line| !line.contains(stop)).collect();
+        let mut ops = Vec::new();
+        let mut i = 0;
+        while i < lines.len() {
+            if !lines[i].starts_with(attr) {
+                i += 1;
+                continue;
+            }
+            let is_async_attr = lines[i].contains("async");
+            let mut j = i + 1;
+            while j < lines.len() && !lines[j].starts_with("fn ") && !lines[j].starts_with("async fn ") {
+                j += 1;
+            }
+            assert!(j < lines.len(), "no fn found after op attribute at ops.rs:{}", i + 1);
+            let name: String = lines[j]
+                .split("fn ")
+                .nth(1)
+                .unwrap_or("")
+                .chars()
+                .take_while(|c| c.is_alphanumeric() || *c == '_')
+                .collect();
+            assert!(!name.is_empty(), "could not extract op name at ops.rs:{}", j + 1);
+            let mut end = j;
+            while end < lines.len() && lines[end] != "}" {
+                end += 1;
+            }
+            assert!(end < lines.len(), "no closing brace for `{name}` at ops.rs:{}", j + 1);
+            let is_async = is_async_attr || lines[j].starts_with("async fn ");
+            ops.push((name, is_async, lines[j..=end].join("\n")));
+            i = end + 1;
+        }
+        ops
+    }
+
+    /// Names registered in build_extension(), in either the base list or the
+    /// render-gated pushes.
+    fn registered_ops() -> Vec<String> {
+        let start = SRC.find("pub fn build_extension").expect("build_extension not found");
+        let body = &SRC[start..];
+        let body = &body[..body.find("\n}\n").expect("build_extension has no closing brace")];
+        let mut names = Vec::new();
+        let mut rest = body;
+        while let Some(pos) = rest.find("op_") {
+            let tail = &rest[pos..];
+            let name: String = tail.chars().take_while(|c| c.is_alphanumeric() || *c == '_').collect();
+            if tail[name.len()..].starts_with("()") {
+                names.push(name.clone());
+            }
+            rest = &tail[name.len()..];
+        }
+        names
+    }
+
+    /// Every synchronous op must route its body through the shared op_guard
+    /// panic boundary, so a newly added op that skips it fails here instead
+    /// of shipping a path that aborts the process on panic.
+    #[test]
+    fn every_sync_op_is_panic_guarded() {
+        let ops = scan_ops();
+        for (name, is_async, body) in &ops {
+            if *is_async || SYNC_OPS_EXEMPT_FROM_GUARD.contains(&name.as_str()) {
+                continue;
+            }
+            assert!(
+                body.contains("op_guard("),
+                "op `{name}` does not route through op_guard(); every sync op must be panic-guarded"
+            );
+        }
+
+        // A mismatch means the scanner missed an op (or found a stray one).
+        let mut scanned: Vec<String> = ops.iter().map(|(name, _, _)| name.clone()).collect();
+        let mut registered = registered_ops();
+        scanned.sort();
+        registered.sort();
+        assert_eq!(scanned.len(), registered.len(), "scanned ops vs build_extension() registrations");
+        assert_eq!(scanned, registered);
+    }
+
+    #[test]
+    fn op_guard_degrades_a_panic_to_the_fallback_instead_of_aborting() {
+        let result: Result<Vec<u8>, deno_error::JsErrorBox> = op_guard(
+            "test_panicking_op",
+            || Err(crypto_err("test_panicking_op panicked")),
+            || panic!("simulated op panic"),
+        );
+        assert!(result.is_err());
+
+        let result: String = op_guard("test_panicking_op", || "null".to_string(), || panic!("simulated op panic"));
+        assert_eq!(result, "null");
+
+        let result = op_guard("test_ok_op", || -1, || 7);
+        assert_eq!(result, 7);
+    }
 }
