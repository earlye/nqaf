 pub type SharedState = Rc<RefCell<ObscuraState>>;
 
+/// Anti-panic boundary shared by every synchronous op in this file: a panic
+/// inside `f` would otherwise unwind through deno_core into V8's FFI frame,
+/// where V8_Fatal calls abort(3) and takes the whole engine (and every CDP
+/// client) down. Catching it here degrades a single call to `fallback()`
+/// instead. `fallback` is lazy so the happy path is just a landing pad with no
+/// per-call allocation, which matters for hot ops such as `op_dom`. `op_name`
+/// only labels the log line. Every synchronous `#[op2]` function in this file
+/// must route its body through this; see
+/// `op_safety_tests::every_sync_op_is_panic_guarded` for the check that
+/// enforces it.
+///
+/// Async ops (`op_fetch_url`, `op_fetch_body`, `op_sleep`,
+/// `op_load_image_metadata`) are exempt: `catch_unwind` does not compose with
+/// `.await`, and only their first poll runs inside the V8 FFI call that
+/// dispatched them; later polls run from the event loop.
+fn op_guard<T>(op_name: &str, fallback: impl FnOnce() -> T, f: impl FnOnce() -> T) -> T {
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).unwrap_or_else(|_| {
+        tracing::error!("{op_name} panicked; returning fallback");
+        fallback()
+    })
+}
