#!/usr/bin/env bash
set -euo pipefail

ENGINE="oneclaw"
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --engine) ENGINE="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

USAGE="Usage: apply [--engine oneclaw|claude] <fork-dir> <branch> [prompts/feature-NNN.md ...]"
FORK_DIR="${1:?$USAGE}"
shift
BRANCH="${1:?$USAGE}"
shift
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$ROOT_DIR/$FORK_DIR"
WORK_DIR="$CONFIG_DIR/work"

fork="$(cat "$CONFIG_DIR/fork.txt")"

if [ ! -d "$WORK_DIR/.git" ]; then
  echo "Cloning $fork → $WORK_DIR"
  git clone "$fork" "$WORK_DIR"
fi

echo "Fetching origin..."
git -C "$WORK_DIR" fetch origin

default_branch="$(git -C "$WORK_DIR" symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"

if git -C "$WORK_DIR" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
  echo "Branch '$BRANCH' exists on origin; checking it out at its current tip (no reset/rebase)"
  git -C "$WORK_DIR" checkout -B "$BRANCH" "origin/$BRANCH"
else
  echo "Branch '$BRANCH' does not exist on origin; creating it from origin/$default_branch"
  git -C "$WORK_DIR" checkout -B "$BRANCH" "origin/$default_branch"
  git -C "$WORK_DIR" push -u origin "$BRANCH"
fi

HAVE_GH=0
if command -v gh >/dev/null 2>&1; then
  HAVE_GH=1
  echo "Setting gh default repo to $fork"
  (cd "$WORK_DIR" && gh repo set-default "$fork")
else
  echo "gh not found; skipping gh repo set-default and later PR creation" >&2
fi

mkdir -p "$WORK_DIR/.claude"
cat > "$WORK_DIR/.claude/settings.json" <<'EOF'
{
  "defaultMode": "bypassPermissions"
}
EOF

if [ "$#" -gt 0 ]; then
  prompts=("$@")
else
  prompts=("$CONFIG_DIR/prompts/"*.md)
fi

for prompt in "${prompts[@]}"; do
  prompt="$(realpath "$prompt")"
  [ -f "$prompt" ] || { echo "Prompt not found: $prompt" >&2; exit 1; }
  prompt_name="$(basename "$prompt")"
  marker="$WORK_DIR/.nqaf/prompts/$prompt_name"

  if [ -f "$marker" ]; then
    echo "Skipping $prompt_name (already recorded in .nqaf/prompts/)"
    continue
  fi

  echo "Applying $prompt_name..."
  wrapped_prompt="This fix may already be present in this codebase (applied in an
earlier run, merged in from upstream, or implemented independently). Before
making any changes: inspect the relevant code and determine whether the fix
described below has already been fully implemented.

- If it has already been fully implemented, make no code changes — just
  confirm that it is already in place.
- If it has not been fully implemented (in whole or in part), implement it
  as described below.

---

$(cat "$prompt")"

  case "$ENGINE" in
    oneclaw) (cd "$WORK_DIR" && set -x && oneclaw run --prompt "$wrapped_prompt") ;;
    claude)  (cd "$WORK_DIR" && set -x && claude --dangerously-skip-permissions --verbose -p "$wrapped_prompt") ;;
    *) echo "Unknown engine: $ENGINE" >&2; exit 1 ;;
  esac

  mkdir -p "$WORK_DIR/.nqaf/prompts"
  cp "$prompt" "$marker"

  git -C "$WORK_DIR" add -A
  if git -C "$WORK_DIR" diff --cached --quiet; then
    echo "No changes from $prompt_name; nothing to commit"
  else
    git -C "$WORK_DIR" commit -m "Apply $prompt_name"
    git -C "$WORK_DIR" push origin "$BRANCH"
    echo "Committed and pushed $prompt_name to $BRANCH"
  fi
done

if [ "$HAVE_GH" -eq 1 ]; then
  existing_pr="$(cd "$WORK_DIR" && gh pr list --head "$BRANCH" --state all --json number --jq '.[0].number' 2>/dev/null || true)"
  if [ -n "$existing_pr" ]; then
    echo "PR #$existing_pr already exists for $BRANCH → $default_branch"
  else
    echo "Creating PR for $BRANCH → $default_branch"
    (cd "$WORK_DIR" && gh pr create \
      --base "$default_branch" \
      --head "$BRANCH" \
      --title "NQAF: apply prompts on $BRANCH" \
      --body "Automated by \`scripts/apply\`. Prompts applied so far are recorded in \`.nqaf/prompts/\`.") \
      || echo "PR creation failed (e.g. nothing to merge yet, or gh not authenticated) — branch is still pushed" >&2
  fi
fi

echo "Done."
