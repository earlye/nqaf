#!/usr/bin/env bash
set -euo pipefail

ENGINE="claude"
MODEL=""
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --engine) ENGINE="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

USAGE="Usage: apply [--engine claude|oneclaw] [--model <id>] <fork-dir> <branch> [prompts/feature-NNN.md ...]"
[ "$#" -ge 2 ] || { echo "$USAGE" >&2; exit 1; }
FORK_DIR="$1"
BRANCH="$2"
shift 2
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$ROOT_DIR/$FORK_DIR"
WORK_DIR="$CONFIG_DIR/work"
PATCHES_DIR="$CONFIG_DIR/patches"

# shellcheck source=lib/patches.sh
source "$ROOT_DIR/scripts/lib/patches.sh"
# shellcheck source=lib/limits.sh
source "$ROOT_DIR/scripts/lib/limits.sh"

MODEL="$(resolve_model "$ENGINE" "$MODEL")"
fork="$(cat "$CONFIG_DIR/fork.txt")"
fork_slug="$(sed -E 's#^(https://github\.com/|git@github\.com:)##; s#\.git$##' <<<"$fork")"

# `claude -p` kills background tasks after 600s by default; the agent may
# delegate long implementation work to one, so wait for it instead.
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0

if [ ! -d "$WORK_DIR/.git" ]; then
  echo "Cloning $fork → $WORK_DIR"
  git clone --quiet --no-tags "$fork" "$WORK_DIR"
else
  git -C "$WORK_DIR" remote set-url origin "$fork"
fi

echo "Fetching origin..."
git -C "$WORK_DIR" fetch --quiet --no-tags origin

default_branch="$(git -C "$WORK_DIR" symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"

if git -C "$WORK_DIR" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
  echo "Branch '$BRANCH' exists on origin; checking it out at its current tip (no reset/rebase)"
  git -C "$WORK_DIR" checkout -B "$BRANCH" "origin/$BRANCH"
else
  echo "Branch '$BRANCH' does not exist on origin; creating it from origin/$default_branch"
  git -C "$WORK_DIR" checkout -B "$BRANCH" "origin/$default_branch"
  git -C "$WORK_DIR" push -u origin "$BRANCH"
fi

HAVE_GH=0
if command -v gh >/dev/null 2>&1; then
  HAVE_GH=1
  echo "Setting gh default repo to $fork"
  (cd "$WORK_DIR" && gh repo set-default "$fork_slug")
else
  echo "gh not found; skipping gh repo set-default and later PR creation" >&2
fi

mkdir -p "$WORK_DIR/.claude"
cat > "$WORK_DIR/.claude/settings.json" <<'EOF'
{
  "defaultMode": "bypassPermissions"
}
EOF
exclude_local_files "$WORK_DIR"
exclude_build_outputs "$WORK_DIR"

if [ "$#" -gt 0 ]; then
  prompts=("$@")
else
  prompts=("$CONFIG_DIR/prompts/"*.md)
fi

for prompt in "${prompts[@]}"; do
  prompt="$(realpath "$prompt")"
  [ -f "$prompt" ] || { echo "Prompt not found: $prompt" >&2; exit 1; }
  prompt_name="$(basename "$prompt")"
  marker="$WORK_DIR/.nqaf/prompts/$prompt_name"
  decision_file="$WORK_DIR/.nqaf/decisions/$prompt_name"

  if [ -f "$marker" ] && cmp -s "$prompt" "$marker"; then
    echo "Skipping $prompt_name (unchanged since last run; recorded in .nqaf/prompts/)"
    continue
  fi

  echo "Applying $prompt_name..."
  rm -f "$decision_file"
  wrapped_prompt="This fix may already be present in this codebase (applied in an
earlier run, merged in from upstream, or implemented independently). Before
making any changes: inspect the relevant code and determine whether the fix
described below has already been fully implemented.

- If it has already been fully implemented, or upstream has superseded it,
  make no code changes. Instead, as your very last step, write
  \`.nqaf/decisions/$prompt_name\` containing one line \`noop: <reason>\`,
  where <reason> says on that one line where the fix already lives or what
  supersedes it.
- If it has not been fully implemented (in whole or in part), implement it
  as described below. You must change code: a run that changes nothing
  outside \`.nqaf/\` and records no \`noop:\` decision is treated as a
  failure.

Do not commit. Ignore \`.nqaf/prompts/\`; the script maintains it.

---

$(cat "$prompt")"

  case "$ENGINE" in
    oneclaw) (cd "$WORK_DIR" && set -x && run_limited oneclaw run --prompt "$wrapped_prompt") ;;
    claude)  (cd "$WORK_DIR" && set -x && run_limited claude --dangerously-skip-permissions --verbose --model "$MODEL" -p "$wrapped_prompt") ;;
    *) echo "Unknown engine: $ENGINE" >&2; exit 1 ;;
  esac

  noop="$(noop_reason "$decision_file")"
  rm -f "$decision_file"

  git -C "$WORK_DIR" add -A
  unstage_local_files "$WORK_DIR"
  drop_build_outputs "$WORK_DIR"
  # The marker is copied in only after this check passes: a marker left
  # behind by the exit below would make the next run skip this prompt.
  if git -C "$WORK_DIR" diff --cached --quiet -- "${CODE_PATHSPEC[@]}"; then
    if [ -z "$noop" ]; then
      echo "Error: $prompt_name changed nothing outside .nqaf/ and the agent recorded no" \
        "'noop: <reason>' in .nqaf/decisions/$prompt_name; not recording it as applied" >&2
      exit 1
    fi
    echo "No code changes from $prompt_name (noop: $noop)"
  else
    noop=""
  fi

  mkdir -p "$WORK_DIR/.nqaf/prompts"
  cp "$prompt" "$marker"
  git -C "$WORK_DIR" add -- "$marker"
  git -C "$WORK_DIR" commit -m "Apply $prompt_name"
  git -C "$WORK_DIR" push origin "$BRANCH"
  echo "Committed and pushed $prompt_name to $BRANCH"
  # If an earlier application of this prompt (reachable from HEAD^) changed
  # code, the noop may only mean that the earlier application holds the
  # code. export_patch combines the two when it can; when it can't (another
  # commit sits between them), the result is hollow and is refused rather
  # than recorded as a noop.
  dropped_noop=""
  if [ -n "$noop" ]; then
    while read -r c s; do
      if [ "$s" = "Apply $prompt_name" ] && commit_touches_code "$WORK_DIR" "$c"; then
        dropped_noop="$noop"
        noop=""
        break
      fi
    done < <(git -C "$WORK_DIR" log --format='%H %s' -F --grep="Apply $prompt_name" HEAD^)
  fi
  status=0
  export_patch "$WORK_DIR" HEAD "$prompt_name" "$PATCHES_DIR" "" "$noop" || status=$?
  if [ "$status" -eq 1 ]; then
    if [ -n "$dropped_noop" ]; then
      echo "Error: the agent recorded 'noop: $dropped_noop', but an earlier application of" \
        "$prompt_name changed code and can't be combined with this one, so that reason is not" \
        "trusted. The stored patch was kept." >&2
    fi
    echo "Error: $prompt_name is now recorded as applied on $BRANCH, but its patch was not" \
      "exported, so the next apply will skip it. Run re-apply to carry the prompt forward." >&2
  fi
  [ "$status" -eq 0 ] || exit 1
done

if [ "$HAVE_GH" -eq 1 ]; then
  existing_pr="$(cd "$WORK_DIR" && gh pr list --head "$BRANCH" --state all --json number --jq '.[0].number' 2>/dev/null || true)"
  if [ -n "$existing_pr" ]; then
    echo "PR #$existing_pr already exists for $BRANCH → $default_branch"
  else
    echo "Creating PR for $BRANCH → $default_branch"
    (cd "$WORK_DIR" && gh pr create \
      --base "$default_branch" \
      --head "$BRANCH" \
      --title "NQAF: apply prompts on $BRANCH" \
      --body "$(attribution_line "$ENGINE" "$MODEL")

Automated by \`scripts/apply\`. Prompts applied so far are recorded in \`.nqaf/prompts/\`.") \
      || echo "PR creation failed (e.g. nothing to merge yet, or gh not authenticated) — branch is still pushed" >&2
  fi
fi

echo "Done."
