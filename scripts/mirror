#!/usr/bin/env bash
set -euo pipefail

FORK_DIR="${1:?Usage: mirror <fork-dir>}"
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$ROOT_DIR/$FORK_DIR"

upstream="$(cat "$CONFIG_DIR/upstream.txt")"
fork="$(cat "$CONFIG_DIR/fork.txt")"

fork_owner="$(sed -E 's#https://github.com/([^/]+)/.*#\1#' <<<"$fork")"
fork_name="$(basename "$fork" .git)"
me="$(gh api user --jq .login)"

args=(--fork-name "$fork_name")
if [[ "$fork_owner" != "$me" ]]; then
  args+=(--org "$fork_owner")
fi

echo "Forking $upstream → $fork"
gh repo fork "$upstream" "${args[@]}"
echo "Done."
