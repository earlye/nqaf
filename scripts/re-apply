#!/usr/bin/env bash
set -euo pipefail

# Carry the fork's features forward onto the latest upstream. Builds a fresh
# nqaf-rebase-<date> branch from upstream/HEAD and, for each prompt in order,
# replays the stored patch (<fork-dir>/patches/feature-NNN.patch) — calling
# the agent only to repair a conflicting patch, update one whose prompt has
# changed, or implement a prompt that has no patch yet. Each feature becomes
# one "Apply <prompt>" commit, whose patch is exported back into this repo.
# New files under build-output directories (target/, node_modules/, a dir with
# a CACHEDIR.TAG, ...) are never committed. Then runs the fork's check once,
# merges the old default branch in with `-s ours` (tree unchanged) so the PR
# is mergeable, pushes, opens a PR into the fork's default branch, and closes
# the earlier nqaf-rebase-*/nqaf-rebuild-* PRs it supersedes. Land the PR with
# scripts/merge-pr (a merge commit). Exits 3 if everything ran but the check failed (the branch
# is still pushed and the PR opened), and 1 on any other error.

ENGINE="claude"
MODEL=""
PUSH=1
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --engine) ENGINE="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --no-push) PUSH=0; shift ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

USAGE="Usage: re-apply [--engine claude|oneclaw] [--model <id>] [--no-push] <fork-dir> [prompts/feature-NNN.md ...]"
[ "$#" -ge 1 ] || { echo "$USAGE" >&2; exit 1; }
FORK_DIR="$1"
shift
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$ROOT_DIR/$FORK_DIR"
WORK_DIR="$CONFIG_DIR/work"
PATCHES_DIR="$CONFIG_DIR/patches"

# shellcheck source=lib/patches.sh
source "$ROOT_DIR/scripts/lib/patches.sh"
# shellcheck source=lib/limits.sh
source "$ROOT_DIR/scripts/lib/limits.sh"
# shellcheck source=lib/carry.sh
source "$ROOT_DIR/scripts/lib/carry.sh"

MODEL="$(resolve_model "$ENGINE" "$MODEL")"
upstream="$(cat "$CONFIG_DIR/upstream.txt")"
fork="$(cat "$CONFIG_DIR/fork.txt")"

prepare_work_dir

if git -C "$WORK_DIR" merge-base --is-ancestor "$upstream_head" origin/HEAD; then
  echo "No upstream changes detected; fork is up to date."
  exit 0
fi

if [ "$#" -gt 0 ]; then
  prompts=("$@")
else
  prompts=("$CONFIG_DIR/prompts/"*.md)
fi

for i in "${!prompts[@]}"; do
  prompts[i]="$(realpath "${prompts[$i]}")"
  [ -f "${prompts[$i]}" ] || { echo "Prompt not found: ${prompts[$i]}" >&2; exit 1; }
done

reset_work_dir

branch="$(unique_branch nqaf-rebase)"

echo "Creating $branch from upstream/HEAD ($(git -C "$WORK_DIR" rev-parse --short "$upstream_head"))"
git -C "$WORK_DIR" checkout -b "$branch" "$upstream_head"

for prompt in "${prompts[@]}"; do
  carry_feature "$prompt"
done

run_check

pr_body="$(git -C "$WORK_DIR" rev-parse --absolute-git-dir)/nqaf-pr-body.md"
write_pr_body "$pr_body" "Automated by \`scripts/re-apply\`: carries the fork's features forward onto upstream \`$upstream_head\`." "$branch"
print_summary

title="NQAF: carry fork forward onto upstream $(git -C "$WORK_DIR" rev-parse --short "$upstream_head")"
[ "$check_result" = "fail" ] && title="$title (CHECK FAILED)"
push_and_open_pr "$branch" "$title" "$pr_body"

if [ "$check_result" = "fail" ]; then
  echo "CHECK FAILED — see $check_log" >&2
  # Distinct from errors (1): the run completed and the branch/PR exist.
  exit 3
fi
echo "Done."
